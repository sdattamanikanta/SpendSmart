
@{
    ViewData["Title"] = "DeletedExpenses";
}

@model List<Expense>
<div class="text-center">
    <h1 class="display-4">Deleted Expenses List</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Value</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expense in Model)
            {
                <tr>
                    <td>@expense.Id</td>
                    <td>@expense.Value</td>
                    <td>@expense.Description</td>
                    <td>
                        <a asp-action="RestoreExpense" asp-route-id="@expense.Id">Restore</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
